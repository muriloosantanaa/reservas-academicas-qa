  <stringProp name="ThreadGroup.duration"></stringProp>
  <stringProp name="ThreadGroup.delay"></stringProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
</PostThreadGroup>
<hashTree>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Verifica exatamente 1 reserva aceita" enabled="true">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">int aceitas = Integer.parseInt(props.getProperty('RESERVAS_ACEITAS', '0'))
SampleResult.setSampleLabel('Invariante: exatamente 1 reserva aceita')
SampleResult.setSuccessful(aceitas == 1)
SampleResult.setResponseCode(aceitas == 1 ? '200' : '500')
SampleResult.setResponseMessage('reservas aceitas = ' + aceitas)
SampleResult.setResponseData('reservas aceitas = ' + aceitas, 'UTF-8')</stringProp>
</JSR223Sampler><hashTree/>
</hashTree>
</hashTree>
</hashTree>
