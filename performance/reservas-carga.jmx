<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Conta reservas aceitas" enabled="true">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// conta quantas respostas foram 200 (aceitas); acesso sincronizado entre as threads
synchronized (props) {
    int atual = Integer.parseInt(props.getProperty('RESERVAS_ACEITAS', '0'))
    if (prev.getResponseCode() == '200') { atual++ }
    props.put('RESERVAS_ACEITAS', String.valueOf(atual))
}</stringProp>
</JSR223PostProcessor><hashTree/>
</hashTree>
</hashTree>
<PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown - verifica a invariante de concorrencia" enabled="true">
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
